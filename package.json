{
  "name": "capsid",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Capsid: a Cloudflare-native MCP server serving a consolidated knowledge base from D1 and R2",
  "license": "MIT",
  "engines": {
    "node": ">=26.11.1",
    "npm": "12.2.1"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "types": "node scripts/dry-run-config.mjs && wrangler types worker-configuration.d.ts --config wrangler.dryrun.jsonc --include-runtime=false",
    "check": "tsc --noEmit",
    "check:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "node scripts/test-budget.mjs \"test/*.test.ts\"",
    "verify:live": "node scripts/verify-live.mjs",
    "test:integration": "vitest run",
    "check:integration": "tsc --noEmit -p test-integration/tsconfig.json",
    "check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "check:dashboard": "npm --prefix dashboard run check",
    "build:dashboard": "npm --prefix dashboard run build && npm --prefix dashboard run size",
    "test:browser": "npm --prefix dashboard run e2e",
    "lint": "node --import ./test/resolve-ts.mjs --test \"test/lint/*.lint.ts\"",
    "lint:promises": "oxlint --type-aware --tsconfig tsconfig.json src",
    "lint:dead-exports": "node --import ./test/resolve-ts.mjs --test test/lint/dead-exports.lint.ts",
    "lint:docs": "node --import ./test/resolve-ts.mjs --test test/lint/docs.lint.ts",
    "report:bloat": "devkit-no-bloat"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261029.1",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.20.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "jscpd": "5.4.2",
    "knip": "6.42.1",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.20.0",
    "@dustinedwards/d1-dump": "github:DrDustinEdwards/d1-dump#v0.6.0",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.43.0",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.32.0",
    "jose": "6.2.14",
    "zod": "4.6.7"
  },
  "overrides": {
    "undici": "7.30.1",
    "sharp": "0.35.5",
    "agents": {
      "@modelcontextprotocol/client": "$@modelcontextprotocol/client",
      "@modelcontextprotocol/sdk": "1.32.1"
    }
  }
}
