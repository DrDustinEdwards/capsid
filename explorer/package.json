{
  "name": "capsid-explorer",
  "private": true,
  "description": "capsid.dustinedwards.info: the system explorer, prerendered from Capsid's public model and numbers (capsid/research/design-system-explorer.md, section 4).",
  "type": "module",
  "scripts": {
    "build": "node --import ../test/resolve-ts.mjs build.mjs",
    "check": "tsc -p .",
    "test": "node --import ../test/resolve-ts.mjs --test \"test/*.test.mjs\"",
    "e2e": "playwright test",
    "indexnow": "node indexnow.mjs"
  },
  "dependencies": {
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.41.2",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.87.0",
    "enarratio": "0.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@dagrejs/dagre": "3.1.3",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "lighthouse": "13.5.0"
  },
  "overrides": {
    "capsomer": {
      "enarratio": "$enarratio"
    }
  },
  "allowScripts": {
    "esbuild": false
  }
}
