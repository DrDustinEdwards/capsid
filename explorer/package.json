{
  "name": "capsid-explorer",
  "private": true,
  "description": "capsid.dustinedwards.info: the system explorer, prerendered from Capsid's public model and numbers (capsid/research/design-system-explorer.md, section 4).",
  "type": "module",
  "scripts": {
    "build": "node --import ../test/resolve-ts.mjs build.mjs",
    "check": "tsc -p .",
    "test": "node --import ../test/resolve-ts.mjs --test \"test/*.test.mjs\"",
    "e2e": "playwright test",
    "indexnow": "node indexnow.mjs"
  },
  "dependencies": {
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.69.0",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.182.4",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.164.10",
    "enarratio": "0.17.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@dagrejs/dagre": "3.1.3",
    "@playwright/test": "1.65.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "hast-util-to-mdast": "10.1.4",
    "hastscript": "9.0.3",
    "htmlparser2": "12.0.0",
    "lighthouse": "13.6.0",
    "lightningcss": "1.33.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.2.4",
    "rolldown": "1.3.3"
  },
  "overrides": {
    "capsomer": {
      "enarratio": "$enarratio"
    }
  },
  "allowScripts": {
    "esbuild": false
  }
}
