{
  "name": "capsid-explorer",
  "private": true,
  "type": "module",
  "description": "capsid.dustinedwards.info: the system explorer, prerendered from Capsid's public model and numbers (capsid/research/design-system-explorer.md, section 4).",
  "scripts": {
    "build": "node --import ../test/resolve-ts.mjs build.mjs",
    "check": "tsc -p .",
    "test": "node --import ../test/resolve-ts.mjs --test \"test/*.test.mjs\"",
    "e2e": "playwright test",
    "indexnow": "node indexnow.mjs"
  },
  "dependencies": {
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.21.0",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.53.0",
    "enarratio": "0.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@dagrejs/dagre": "3.1.1",
    "@playwright/test": "1.64.1",
    "lighthouse": "13.5.0"
  }
}
