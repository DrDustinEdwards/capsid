{
  "name": "capsid-watch-floor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Watch Floor: the operations dashboard the capsid Worker serves at /portal/",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "check": "node scripts/fixture-check.mjs && tsc --noEmit -p .",
    "size": "node scripts/size-budget.mjs",
    "preview": "vite preview",
    "e2e": "playwright test",
    "shots": "playwright test -c playwright.shots.config.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.61.0",
    "enarratio": "0.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
