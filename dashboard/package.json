{
  "name": "capsid-watch-floor",
  "version": "0.1.0",
  "private": true,
  "description": "Capsid Portal: the operations dashboard the capsid Worker renders on portal.dustinedwards.info",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "npm run check && react-router build && npm run build:worker && npm run build:demo",
    "build:worker": "vite build -c vite.worker.config.ts",
    "build:demo": "node --import ../test/resolve-ts.mjs scripts/demo-api.mjs",
    "check": "node scripts/fixture-check.mjs && react-router typegen && tsc --noEmit -p .",
    "serve": "node --import ../test/resolve-ts.mjs dev/serve.ts",
    "e2e": "playwright test",
    "shots": "playwright test -c playwright.shots.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.3",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.94.0",
    "enarratio": "^0.12.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.5.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
