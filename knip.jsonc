{
  // Knip for the Worker package. This file only names what Knip cannot see by convention (knip.dev,
  // "Configuration"): the Worker's entry (wrangler.jsonc is not committed, so the
  // Wrangler plugin cannot read its "main"), the scripts and tests run by path, the dashboard's re-export of the
  // feed types and the cloudflare: virtual modules @cloudflare/vitest-plugin provides.
  // The dashboard runs on Knip's defaults (its Vite, React and
  // Playwright plugins find its entries) with `knip --directory dashboard`.
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/index.ts", "scripts/*.{mjs,ts}", "test/**/*.ts", "test-integration/**/*.ts", "dashboard/src/types.ts"],
  "project": ["src/**/*.ts", "scripts/**/*.{mjs,ts}", "test/**/*.ts", "test-integration/**/*.ts"],
  // jscpd is run by devkit-no-bloat (.no-bloat.json), and @modelcontextprotocol/conformance by
  // devkit-conformance (.conformance.json), each through its bin, which Knip does not trace.
  "ignoreDependencies": ["cloudflare", "jscpd", "@modelcontextprotocol/conformance"]
}
