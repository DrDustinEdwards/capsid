{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "capsid-mcp",
  "main": "src/index.ts",
  // Bumped 2026-06-01 -> 2026-09-06 (platform arc). nodejs_compat is enabled by
  // default for dates >= 2026-08-04, so the explicit flag below is now redundant;
  // it stays because an explicit flag survives a future date rollback and costs
  // nothing. scripts/bindings.mjs carries the same date and
  // test/cloudflare-platform.test.ts fails if the two drift.
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  // keep_names stays at its default (true), so stack traces and source maps keep function names.
  "minify": true,
  "upload_source_maps": true,
  // Logs on, and traces at one invocation in ten (job_beedff911c01; Cloudflare's Workers
  // best-practices guide says to enable both with head_sampling_rate). Traces are beta,
  // stored traces bill under Observability pricing from 2026-12-01 with 7-day retention,
  // and the traffic is a five-minute cron tick plus operator tool calls, so a tenth
  // keeps the volume small while a slow or failing tick is still likely to show up
  // within an hour. Raise it to 1 while chasing a specific fault.
  // Logs are stated too (area 8, L1): every log line kept, head_sampling_rate 1, since
  // the volume is the same tick and tool calls and a dropped error line is not recoverable.
  "observability": { "enabled": true, "head_sampling_rate": 1, "traces": { "enabled": true, "head_sampling_rate": 0.1 } },
  // THE RUNAWAY GUARD (Cloudflare platform arc 2026-09-06, resized 2026-09-07).
  // Budget alerts are informational and cannot stop a Worker, so the
  // per-invocation CPU ceiling is the one platform-enforced hard stop.
  //
  // MEASURED, and then PROJECTED, because the two give different answers and the
  // measurement alone is the trap. Workers Observability over 2026-09-01..09-07,
  // filtered to the backup trigger: max cpuTimeMs 1390, p99 1390, n=10. The old
  // ceiling of 2100 is 1390 * 1.5, so it satisfied its own stated rule on the day
  // it was written and would have kept satisfying it while quietly running out.
  //
  // What the rule missed is that the backup's cost is a function of a table that
  // has never been pruned. `document_versions` in the off-account mirror went
  // 25,529,382 bytes (2026-08-15) to 53,948,435 bytes (2026-09-07): it more than
  // doubled in 23 days, and the 90-day prune has not fired yet because the oldest
  // rows date from 2026-07-06. First prune lands about 2026-10-04, so the table
  // grows for roughly another month at ~1.2MB/day to about 87MB before it reaches
  // steady state. The dump is JSON.stringify over those rows, so CPU tracks bytes
  // almost linearly: 1390ms at ~54MB projects to ~2240ms at ~87MB, which the old
  // 2100 would have killed mid-run.
  //
  // 2240 * 1.5, rounded, is the number below. Sized against where the workload is
  // going rather than where it was on one measured week. scripts/bindings.mjs
  // exports the same number and test/cloudflare-platform.test.ts fails if they
  // drift; that test also asserts the floor, so shrinking this is a build failure.
  "limits": { "cpu_ms": 3500 },
  // THREE CRONS. src/index.ts dispatches on which one fired and exports the same
  // three strings; test/crons.test.ts derives one list from the other and fails in
  // both directions, so this config and the handler cannot drift.
  //   "0 9 * * *"    the daily backup.
  //   "*/5 * * * *"  the tick: auto-merge, the watcher, maintenance and the rest of
  //                  src/tick.ts.
  //   "30 9 * * *"   the weekly skills refresh. Fires DAILY and readSchedule in
  //                  src/skills-refresh.ts decides whether today is the
  //                  configured day, so the day is a KV edit not a redeploy.
  "triggers": { "crons": ["0 9 * * *", "*/5 * * * *", "30 9 * * *"] },
  // CAPSID PORTAL (dashboard/, built to dashboard/dist by scripts/deploy.mjs).
  // run_worker_first is REQUIRED, not a preference: with it off, the platform's
  // navigation handling could answer a browser's /authorize or /portal/callback with
  // index.html and break both logins. Every request reaches the Worker, which serves an
  // asset only under /portal/ and only after the Portal gate. not_found_handling
  // is "none" because the Worker does the single-page fallback itself, after the gate.
  // scripts/dry-run-config.mjs removes this block (between the two markers) for
  // `npm run types`, which builds no dashboard.
  // ASSETS-BEGIN
  "assets": { "directory": "./dashboard/dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "none" },
  // ASSETS-END
  // Non-secret vars. The GitHub App client id is public; the App private key is set
  // with `wrangler secret put` and never committed. The installation id is not
  // configured at all: it is resolved per owner and repo at run time.
  //   wrangler secret put GITHUB_APP_PRIVATE_KEY       (paste the .pem contents)
  //   wrangler secret put IMPROVE_SCORE_SECRET         (root of the job, policy and
  //                                                     backup credential HMAC keys)
  //   wrangler secret put CF_ACCESS_SYNC_TOKEN         (POST /ops/access-sync only:
  //                                                     Access: Groups Write, Access: Users
  //                                                     Read, Zero Trust: Seats Write)
  //   wrangler secret put GSC_SERVICE_ACCOUNT_KEY      (capsid_inspect_repo action search:
  //                                                     a Google service account's JSON key,
  //                                                     docs/search-console.md)
  //   wrangler secret put BING_WEBMASTER_API_KEY       (capsid_inspect_repo action bing:
  //                                                     Bing Webmaster Tools' API key,
  //                                                     docs/bing-webmaster.md)
  "vars": {
    "GITHUB_APP_CLIENT_ID": "YOUR_GITHUB_APP_CLIENT_ID"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "capsid",
      "database_id": "YOUR_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  // TWO DISTINCT NAMESPACES as of 2026-08-15. They shared one id until then, which
  // meant the Worker's own caches (gh:*) lived in the same keyspace as the OAuth
  // provider's grants and tokens. The placeholders are deliberately different: a
  // single shared placeholder made it structurally impossible for CI to emit two
  // different ids, so the split could not have been deployed by CI at all.
  "kv_namespaces": [
    {
      "binding": "APP_KV",
      "id": "YOUR_APP_KV_ID"
    },
    {
      "binding": "OAUTH_KV",
      "id": "YOUR_OAUTH_KV_ID"
    }
  ],
  // MEDIA holds backups, the markdown mirror and the CSP report sink.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "YOUR_R2_BUCKET"
    }
  ],
  // TWO DURABLE OBJECTS from @dustinedwards/site-runtime, exported by src/index.ts.
  //   RATE_LIMITER   the family's exact limiter (site-runtime/rate-limit): /mcp and
  //                  /ops/mcp per caller, the CSP report sink, the public documents and
  //                  the Access sync. Each fails closed when it cannot count.
  //   TOOL_CALL_LOG  the append-only, hash-chained log of every tool call (site-runtime
  //                  /audit-log): refused, started, finished, and each MCP sign-in.
  // Both are SQLite-backed, so their classes are created by the migration below.
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "TOOL_CALL_LOG", "class_name": "ToolCallLog" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter", "ToolCallLog"] }],
  // THE MEANING INDEX. Cloudflare AI Search, namespace-scoped, so the Worker creates
  // its own instance (capsid-docs, built-in storage) on first use and needs no id here.
  // src/doc-index.ts feeds it from D1 on the tick; D1 stays the source of truth
  // (capsid/research/design-hybrid-search.md). The deploy token needs AI Search Edit.
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default"
    }
  ]
}
