  ],
  "containers": [
    {
      "id": "capsid-worker",
      "system": "capsid",
      "name": "MCP Worker",
      "kind": "worker",
      "technology": "Cloudflare Worker",
      "description": "Serves MCP, the operator routes, /health and the Portal's API."
    },
    {
      "id": "capsid-portal",
      "system": "capsid",
      "name": "Portal",
      "kind": "site",
      "technology": "React, served by the Worker",
      "description": "The admin view, behind Cloudflare Access."
    },
    {
      "id": "capsid-tick",
      "system": "capsid",
      "name": "Five-minute tick",
      "kind": "cron",
      "technology": "Workers cron trigger",
      "description": "Lease sweep, auto-merge, the watcher and the daily passes."
    },
    {
      "id": "capsid-db",
      "system": "capsid",
      "name": "capsid",
      "kind": "database",
      "technology": "D1 with FTS5",
      "description": "Documents, jobs, agents and the audit log."
    },
    {
      "id": "capsid-media",
      "system": "capsid",
      "name": "capsid-media",
      "kind": "bucket",
      "technology": "R2",
      "description": "Media and the daily backups."
    },
    {
      "id": "capsid-kv",
      "system": "capsid",
      "name": "app KV",
      "kind": "kv",
      "technology": "Workers KV",
      "description": "Caches, rate-limit counters and computed documents."
    },
    {
      "id": "capsid-agents",
      "system": "capsid",
      "name": "Agents",
      "kind": "external",
      "technology": "Coding sessions over MCP",
      "description": "The sessions that post, claim and work jobs, outside Capsid's boundary."
    },
    {
      "id": "capsid-github",
      "system": "capsid",
      "name": "GitHub",
      "kind": "external",
      "technology": "Repos, pull requests, Actions",
      "description": "Where the code, the pull requests and CI live. Capsid reaches it through its GitHub App."
    }
  ],
  "relationships": [
    { "from": "capsid-worker", "to": "capsid-db", "kind": "writes" },
    { "from": "capsid-worker", "to": "capsid-media", "kind": "writes" },
    { "from": "capsid-worker", "to": "capsid-kv", "kind": "writes" },
    { "from": "capsid-worker", "to": "capsid-portal", "kind": "serves" },
    { "from": "capsid-worker", "to": "capsid-agents", "kind": "serves" },
    { "from": "capsid-worker", "to": "capsid-github", "kind": "writes" },
    { "from": "capsid-worker", "to": "capsid-github", "kind": "reads" },
    { "from": "capsid-tick", "to": "capsid-github", "kind": "reads" },
    { "from": "capsid-tick", "to": "capsid-github", "kind": "writes" },
    { "from": "capsid-github", "to": "capsid-worker", "kind": "deploys" },
    { "from": "capsid-github", "to": "capsid-worker", "kind": "watches" },
    { "from": "capsid-tick", "to": "capsid-db", "kind": "writes" },
    { "from": "capsid-tick", "to": "capsid-kv", "kind": "writes" },
    { "from": "capsid", "to": "d1-dump", "kind": "installs" },
    { "from": "capsid", "to": "site-runtime", "kind": "installs" },
    { "from": "capsid", "to": "capsomer", "kind": "installs" },
    { "from": "carrel", "to": "site-api", "kind": "installs" },
    { "from": "carrel", "to": "dustinedwards-info", "kind": "publishes-to" },
    { "from": "carrel", "to": "germomics", "kind": "publishes-to" },
    { "from": "dustinedwards-mcp", "to": "dustinedwards-info", "kind": "publishes-to" },
    { "from": "capsid", "to": "capsomer", "kind": "coordinates" },
    { "from": "capsid", "to": "carrel", "kind": "coordinates" },
    { "from": "capsid", "to": "dustinedwards-info", "kind": "coordinates" },
    { "from": "capsid", "to": "enarratio", "kind": "coordinates" },
    { "from": "capsid", "to": "foxhound", "kind": "coordinates" },
    { "from": "capsid", "to": "foxing", "kind": "coordinates" },
    { "from": "capsid", "to": "germomics", "kind": "coordinates" }
  ],
  "flows": [
    {
      "id": "job-life",
      "name": "A job's life",
      "description": "One job from the moment it is posted to the moment GitHub's record is checked against what its agent claimed.",
      "steps": [
        { "from": "capsid-worker", "kind": "serves", "to": "capsid-agents", "toward": "capsid-worker", "lights": ["capsid-db"], "text": "Posted: a session posts a job over MCP. The Worker checks the caller's grant, picks the model, signs the body and stores the job." },
        { "from": "capsid-worker", "kind": "serves", "to": "capsid-agents", "toward": "capsid-worker", "lights": ["capsid-db"], "text": "Claimed: an agent claims it. The Worker verifies the body's signature first, then gives the claim a lease." },
        { "from": "capsid-worker", "kind": "serves", "to": "capsid-agents", "toward": "capsid-worker", "lights": ["capsid-db"], "text": "Worked: the agent works on one branch of one repo and sends heartbeats that keep its lease alive." },
        { "from": "capsid-worker", "kind": "serves", "to": "capsid-agents", "toward": "capsid-agents", "lights": ["capsid-db"], "text": "Blocked: at a push, a deploy, a secret or a merge the agent stops. The job waits with the exact command a person or the signed policy must approve, and resume hands it back." },
        { "from": "capsid-worker", "kind": "writes", "to": "capsid-github", "toward": "capsid-github", "text": "Pull request: the pull request opens through Capsid's GitHub App, and CI runs on it." },
        { "from": "capsid-tick", "kind": "writes", "to": "capsid-github", "toward": "capsid-github", "text": "Merged: the five-minute tick merges a pull request whose CI is green on its exact head under the signed auto-merge policy, or the seat merges it." },
        { "from": "capsid-github", "kind": "deploys", "to": "capsid-worker", "toward": "capsid-worker", "text": "Deployed: the merge to master runs CI on GitHub Actions, which deploys the Worker." },
        { "from": "capsid-github", "kind": "watches", "to": "capsid-worker", "toward": "capsid-github", "text": "Verified: CI's live gate reads the Worker's /health and checks it reports the commit that was merged." },
        { "from": "capsid-worker", "kind": "reads", "to": "capsid-github", "toward": "capsid-worker", "lights": ["capsid-db"], "text": "Claims checked: when the job completes, the Worker reads the pull request, its commits and CI from GitHub and records each claim beside what GitHub says." }
      ]
    }
  ]
}
